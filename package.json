{
  "name": "moi-goroda",
  "private": true,
  "description": "«Мои города» — прототип карты поездок для СберТревел",
  "type": "module",
  "scripts": {
    "cities": "python3 scripts/build_cities.py data/city.csv data/cities.json",
    "geo": "node scripts/geo.mjs node_modules/world-atlas/countries-50m.json data/cities.json data/map-data.json",
    "build": "python3 scripts/build.py"
  },
  "devDependencies": {
    "d3-geo": "3.1.0",
    "topojson-client": "3.1.0",
    "topojson-simplify": "3.0.3",
    "world-atlas": "2.0.2"
  }
}
